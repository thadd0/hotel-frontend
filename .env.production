# ── Producción ─────────────────────────────────────────────────
# Vite carga este archivo automáticamente con "npm run build".
#
# VITE_API_URL vacío = URLs relativas (/api/*, /auth/*).
# Funciona porque nginx (contenedor frontend) hace proxy
# de /api/* y /auth/* al backend internamente via Docker.
#
# NO pongas una URL absoluta aquí — rompe el proxy de nginx.
VITE_API_URL=
